{
  "name": "pitch-pilot",
  "version": "0.1.0",
  "private": true,
  "description": "PitchPilot is a hackathon-scale AI outbound sales agency. A user supplies a product landing page and a CSV of leads; the system extracts product knowledge, prepares personalized strategies, triggers one outbound call at a time, and displays the transcript and sales outcome on a live dashboard.",
